{
  "name": "transcriber",
  "version": "0.3.1-dev",
  "description": "Local audio transcription powered by whisper.cpp",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "setup": "bash scripts/setup.sh",
    "package": "npm run package:win",
    "prepackage:win": "node scripts/verify-transcribe-runtime.js win32-x64",
    "package:win": "electron-builder --win",
    "prepackage:linux": "node scripts/verify-transcribe-runtime.js linux-x64",
    "package:linux": "electron-builder --linux",
    "package:mac": "electron-builder --mac",
    "prepackage:all": "node scripts/verify-transcribe-runtime.js win32-x64 && node scripts/verify-transcribe-runtime.js linux-x64",
    "package:all": "electron-builder --win --linux --mac"
  },
  "devDependencies": {
    "electron": "^42.0.1",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "koffi": "3.1.1",
    "transcribe-cpp": "0.1.3"
  }
}
